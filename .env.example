# Porta do servidor
PORT=3001

# Conexão com o banco de dados PostgreSQL (Supabase)
# Exemplo Supabase: postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:suasenha@localhost:5432/catalogoflash?schema=public"

# Chave secreta para JWT
JWT_SECRET="super-secret-jwt-key-troque-em-producao"
JWT_EXPIRES_IN="7d"

# Cloudflare R2 (Compatível com S3)
CLOUDFLARE_ACCOUNT_ID="532284de9961d074dcb41ca6b48cf428"
R2_ACCESS_KEY_ID="e8831d6f862c669c84de28599f6f280c"
R2_SECRET_ACCESS_KEY="dd7ce2d1a81d84de184dc335f35a16cb9e92a2b77e98893e0843c98466835097"
